{
  "uid": "ec-overview",
  "title": "EC Overview (sample-ec-service)",
  "tags": ["sample-ec", "otel"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "SLI / SLO (CUJ ベース)",
      "description": "クリティカルユーザージャーニー別の SLI と SLO 閾値。可用性 = 非5xx率。閾値色はラボ用の暫定 SLO。",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 50,
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "閲覧 可用性 (inventory)",
      "description": "商品/在庫の閲覧 (inventory GET) の非5xx率。SLO: ≥99.9% 緑 / ≥99% 黄 / <99% 赤。4xx はユーザー起因のため成功に含む。",
      "id": 51,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(increase(http_server_request_duration_seconds_count{service_name=\"inventory\",http_response_status_code!~\"5..\"}[$__range])) / clamp_min(sum(increase(http_server_request_duration_seconds_count{service_name=\"inventory\"}[$__range])), 1)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 99 },
              { "color": "green", "value": 99.9 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "閲覧 p95 レイテンシ (inventory)",
      "description": "inventory HTTP サーバの p95 レイテンシ (秒)。SLO しきい: <0.2s 緑 / <0.5s 黄 / ≥0.5s 赤。",
      "id": 52,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"inventory\"}[$__rate_interval])))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.2 },
              { "color": "red", "value": 0.5 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "注文作成 可用性 (order POST /orders)",
      "description": "注文作成エンドポイント (POST /orders) の非5xx率。SLO: ≥99.5% 緑 / ≥99% 黄 / <99% 赤。422 (バリデーション) はユーザー起因のため成功に含む。",
      "id": 53,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(increase(http_server_duration_milliseconds_count{service_name=\"order\",http_target=\"/orders\",http_method=\"POST\",http_status_code!~\"5..\"}[$__range])) / clamp_min(sum(increase(http_server_duration_milliseconds_count{service_name=\"order\",http_target=\"/orders\",http_method=\"POST\"}[$__range])), 1)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 99 },
              { "color": "green", "value": 99.5 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "注文確定 ビジネス成功率 (在庫切れ含む)",
      "description": "confirmed / (confirmed + failed)。FAILED は在庫不足 (ビジネス起因の拒否) を含むため、これは信頼性 SLI ではなくビジネス指標。システム信頼性は上記の HTTP 可用性で見る。SLO: ≥99% 緑 / ≥95% 黄 / <95% 赤。",
      "id": 54,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(increase(order_status_transitions_total{status=\"confirmed\"}[$__range])) / clamp_min(sum(increase(order_status_transitions_total{status=~\"confirmed|failed\"}[$__range])), 1)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
