# Local-only ZITADEL bootstrap settings. Copy this file to .env before starting Compose.
# Do not use these values outside a local development environment.
ZITADEL_MASTERKEY=local-development-master-key-123
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=ChangeMe1!
ZITADEL_POSTGRES_PASSWORD=zitadel-local-password

# Local-only application users. These values are intentionally examples: use
# different credentials in your untracked .env file.
ZITADEL_CUSTOMER_1_USERNAME=customer-one
ZITADEL_CUSTOMER_1_EMAIL=customer-one@example.test
ZITADEL_CUSTOMER_1_PASSWORD=Customer1!
ZITADEL_CUSTOMER_2_USERNAME=customer-two
ZITADEL_CUSTOMER_2_EMAIL=customer-two@example.test
ZITADEL_CUSTOMER_2_PASSWORD=Customer2!
ZITADEL_ADMIN_USERNAME=ec-admin
ZITADEL_ADMIN_EMAIL=ec-admin@example.test
ZITADEL_ADMIN_PASSWORD=Admin1!

# Used by the k6 service account for the OAuth 2.0 client-credentials flow.
ZITADEL_K6_CLIENT_SECRET=local-k6-client-secret-change-me
